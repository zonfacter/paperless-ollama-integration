COMPOSE_PROJECT_NAME=paperless-ai

TZ=Europe/Berlin

BROKER_CPUS=0.50
BROKER_MEM_LIMIT=256m
DB_CPUS=1.50
DB_MEM_LIMIT=2g
GOTENBERG_CPUS=2.00
GOTENBERG_MEM_LIMIT=2g
GOTENBERG_SHM_SIZE=1g
TIKA_CPUS=1.00
TIKA_MEM_LIMIT=1g
PAPERLESS_WEBSERVER_CPUS=2.00
PAPERLESS_WEBSERVER_MEM_LIMIT=2g
PAPERLESS_CONSUMER_CPUS=1.50
PAPERLESS_CONSUMER_MEM_LIMIT=1536m
PAPERLESS_TASK_QUEUE_CPUS=2.00
PAPERLESS_TASK_QUEUE_MEM_LIMIT=2g
PAPERLESS_SCHEDULER_CPUS=0.50
PAPERLESS_SCHEDULER_MEM_LIMIT=512m
OLLAMA_CPUS=6.00
OLLAMA_MEM_LIMIT=12g
PAPERLESS_AI_WEB_CPUS=1.00
PAPERLESS_AI_WEB_MEM_LIMIT=1g
OPEN_WEBUI_CPUS=2.00
OPEN_WEBUI_MEM_LIMIT=2g
PADDLEOCR_CPUS=2.00
PADDLEOCR_MEM_LIMIT=2g
LLAMA_CPP_CPUS=6.00
LLAMA_CPP_MEM_LIMIT=8g

PAPERLESS_BIND_HOST=0.0.0.0
PAPERLESS_PUBLIC_PORT=18000
PAPERLESS_AI_WEB_BIND_HOST=0.0.0.0
PAPERLESS_AI_WEB_PUBLIC_PORT=3000
OPEN_WEBUI_BIND_HOST=0.0.0.0
OPEN_WEBUI_PUBLIC_PORT=8081
OPEN_WEBUI_IMAGE_TAG=v0.8.12
OLLAMA_BIND_HOST=127.0.0.1
OLLAMA_PUBLIC_PORT=11434
PADDLEOCR_BIND_HOST=127.0.0.1
PADDLEOCR_PUBLIC_PORT=8091

PAPERLESS_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
OPEN_WEBUI_SECRET_KEY=CHANGE_ME_OPEN_WEBUI_SECRET
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME
PAPERLESS_ADMIN_MAIL=admin@example.local
PAPERLESS_URL=http://localhost:18000
OPEN_WEBUI_URL=http://localhost:8081

POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=CHANGE_ME_DB_PASSWORD
PAPERLESS_DBPORT=5432

PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu+eng
PAPERLESS_OCR_MODE=force
PAPERLESS_OCR_CLEAN=clean
PAPERLESS_OCR_DESKEW=1
PAPERLESS_OCR_ROTATE_PAGES=1
PAPERLESS_OCR_IMAGE_DPI=300

PAPERLESS_CONSUMER_POLLING=60

PAPERLESS_API_URL=http://paperless-webserver:8000
PAPERLESS_API_TOKEN=REPLACE_WITH_TOKEN
PAPERLESS_POST_CONSUME_SCRIPT=/usr/src/paperless-ai/hooks/ai_enrich.py
PAPERLESS_AI_PROMPT_FILE=/usr/src/paperless-ai/prompts/ai_enrich_prompt.txt
PAPERLESS_AI_PROVIDER=ollama
PAPERLESS_AI_OLLAMA_URL=http://ollama:11434
PAPERLESS_AI_OLLAMA_MODEL=qwen3.5:9b
PAPERLESS_AI_FALLBACK_ENABLED=true
PAPERLESS_AI_FALLBACK_MODEL=qwen3.5:4b
PAPERLESS_AI_FALLBACK_ON_TIMEOUT_ONLY=true
PAPERLESS_AI_HTTP_TIMEOUT_SECONDS=600
PAPERLESS_AI_FALLBACK_HTTP_TIMEOUT_SECONDS=600
PAPERLESS_AI_CONTENT_CHARS=5000
PAPERLESS_AI_TAG_CONTENT_CHARS=5000
PAPERLESS_AI_MIN_CONFIDENCE=0.35
PAPERLESS_AI_DEFAULT_TAG_COLOR=#4f6bed
PAPERLESS_AI_QWEN35_THINK=false
PAPERLESS_AI_OLLAMA_NUM_THREAD=4
PAPERLESS_AI_TAG_REVIEW_ENABLED=true
PAPERLESS_AI_TAG_OLLAMA_MODEL=qwen3.5:9b
PAPERLESS_AI_TAG_HTTP_TIMEOUT_SECONDS=600
PAPERLESS_AI_TAG_FALLBACK_ENABLED=true
PAPERLESS_AI_TAG_FALLBACK_MODEL=qwen3.5:4b
PAPERLESS_AI_TAG_FALLBACK_HTTP_TIMEOUT_SECONDS=600
PAPERLESS_AI_TAG_RULES_FORCE=false
PAPERLESS_AI_REVIEW_MIN_CONFIDENCE=0.8
PAPERLESS_AI_REVIEW_TAG_ENABLED=true
PAPERLESS_AI_REVIEW_TAG_NAME=KI Nachpruefen
PAPERLESS_AI_REVIEW_TAG_COLOR=#7dd3fc

OLLAMA_HOST=0.0.0.0:11434
OLLAMA_INTEL_GPU=1
OLLAMA_VULKAN=1
OLLAMA_FLASH_ATTENTION=0

OLLAMA_WEB_HOST=0.0.0.0
OLLAMA_WEB_PORT=3000
OPEN_WEBUI_ENABLE_OLLAMA_API=true
OPEN_WEBUI_OLLAMA_BASE_URL=http://ollama:11434
OPEN_WEBUI_ENABLE_OPENAI_API=true
OPEN_WEBUI_OPENAI_API_BASE_URL=http://llama-cpp:8080/v1
OPEN_WEBUI_OPENAI_API_KEY=dummy
OPEN_WEBUI_RAG_EMBEDDING_ENGINE=ollama
OPEN_WEBUI_RAG_EMBEDDING_MODEL=nomic-embed-text:latest
OPEN_WEBUI_PDF_EXTRACT_IMAGES=True
OPEN_WEBUI_CHUNK_SIZE=1500
OPEN_WEBUI_CHUNK_OVERLAP=150
OPEN_WEBUI_RAG_TOP_K=5
OPEN_WEBUI_ENABLE_RAG_HYBRID_SEARCH=True
OPEN_WEBUI_CONTENT_EXTRACTION_ENGINE=default
OPEN_WEBUI_TIKA_SERVER_URL=http://tika:9998
LLAMA_CPP_MODEL=Qwen3.5-4B-Q4_K_M.gguf
LLAMA_CPP_GPU_LAYERS=99
LLAMA_CPP_CTX_SIZE=4096
LLAMA_CPP_THREADS=4
LLAMA_CPP_MODELS_PATH=/volume1/docker/llama-cpp-test/models
PAPERLESS_CONF=/config/paperless-ai.env
PAPERLESS_BACKFILL=/usr/src/paperless-ai/scripts/ai_backfill.py
PAPERLESS_PREVIEW_CONFIG_PATH=/data/preview_config.json
PAPERLESS_BACKFILL_STATE_PATH=/data/backfill_jobs.json
PAPERLESS_PROVIDER_CONFIG_PATH=/data/provider_config.json
PAPERLESS_MODEL_CONFIG_PATH=/data/model_config.json
PAPERLESS_PROVIDER_LOCAL_OCR_URL=http://paddleocr-api:8091
PAPERLESS_PREVIEW_OCR_SOURCE=paperless
PAPERLESS_PREVIEW_OCR_MODEL=qwen3.5:4b
PAPERLESS_PREVIEW_OLLAMA_NUM_CTX=32768
PAPERLESS_PREVIEW_PADDLEOCR_API_URL=http://paddleocr-api:8091
PAPERLESS_PREVIEW_PADDLEOCR_TIMEOUT_SECONDS=90
PAPERLESS_PREVIEW_PADDLEOCR_MAX_PAGES=1
PAPERLESS_PREVIEW_VISION_MODEL=qwen3.5:0.8b
PAPERLESS_PREVIEW_VISION_CONTENT_CHARS=800
PAPERLESS_PREVIEW_VISION_TIMEOUT_SECONDS=120
PAPERLESS_PREVIEW_VISION_MAX_PAGES=1
PAPERLESS_PREVIEW_VISION_TAG_NAME=KI Vision
PAPERLESS_PREVIEW_VISION_TAG_COLOR=#d97706

PADDLEOCR_LANG=german
PADDLEOCR_DEVICE=cpu
PADDLEOCR_CPU_THREADS=4
PADDLEOCR_ENABLE_MKLDNN=true
