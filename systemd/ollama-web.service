[Unit]
Description=Minimal Ollama Web UI
After=network.target ollama.service
Requires=ollama.service

[Service]
# Replace PAPERLESS_UI_USER with the actual local user that should run the web UI.
User=PAPERLESS_UI_USER
Group=PAPERLESS_UI_USER
WorkingDirectory=/home/PAPERLESS_UI_USER/ollama-web
Environment=OLLAMA_WEB_HOST=0.0.0.0
Environment=OLLAMA_WEB_PORT=3000
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
ExecStart=/usr/bin/python3 /home/PAPERLESS_UI_USER/ollama-web/server.py
Restart=always

[Install]
WantedBy=multi-user.target
